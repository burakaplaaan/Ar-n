rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin — hibrit:
    // 1) Aşağıdaki e-postalar her zaman tam yetkili developer.
    // 2) `admin_users/{uid}.role`: content / manager / developer.
    // 3) `admin_invites/{email}.role`: e-posta ile ön yetki.
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    function isFullAccessEmail() {
      return authEmail() in [
        'burakmelihkuzi@gmail.com',
        'brkkpl5@gmail.com',
        'seyirteknikerr@gmail.com',
      ];
    }

    function adminUserDoc() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function adminInviteDoc() {
      return get(/databases/$(database)/documents/admin_invites/$(authEmail()));
    }

    function adminUserRole() {
      return exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        ? (
          adminUserDoc().data.role == null || adminUserDoc().data.role == ''
            ? 'content'
            : adminUserDoc().data.role
        )
        : null;
    }

    function adminInviteRole() {
      return authEmail() != null
        && exists(/databases/$(database)/documents/admin_invites/$(authEmail()))
        ? adminInviteDoc().data.role
        : null;
    }

    function adminRole() {
      return !signedIn()
        ? null
        : signedInAdminRole();
    }

    function signedInAdminRole() {
      let userRole = adminUserRole();
      return isFullAccessEmail()
          ? 'developer'
          : userRole != null
            ? userRole
            : adminInviteRole();
    }

    function isAdmin() {
      return adminRole() in ['content', 'manager', 'developer'];
    }

    function isManagerOrDeveloper() {
      return adminRole() in ['manager', 'developer'];
    }

    function isDeveloper() {
      return adminRole() == 'developer';
    }

    // Admin listesi — developer tümünü yönetir; kullanıcı kendi kaydını
    // okuyabilir ("ben admin miyim?" kontrolü için).
    match /admin_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isDeveloper());
      allow list: if isDeveloper();
      allow write: if isDeveloper();
    }

    // E-posta ile yetki davetleri. Kullanıcı yalnızca kendi e-posta davetini
    // okuyabilir; developer tümünü yönetir.
    match /admin_invites/{email} {
      allow get: if signedIn() && (authEmail() == email || isDeveloper());
      allow list: if isDeveloper();
      allow write: if isDeveloper();
    }

    // Admin işlem geçmişi. Yazma admin panelinden gelir; okuma developer.
    match /admin_audit/{auditId} {
      allow create: if isAdmin();
      allow read: if isDeveloper();
      allow update, delete: if false;
    }

    // Söz havuzları — herkes okur; yazma yalnızca admin.
    match /quote_pools/{poolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bildirim havuzu — admin panelden yönetilir; okuma yalnızca admin.
    match /admin_ntf_pool/{docId} {
      allow read, write: if isAdmin();
    }

    // Bildirim otomatik gönderim yapılandırması.
    // current_moment: Cloud Function'ın yazdığı anlık ayet verisi;
    // bildirime tıklayan herkes (oturum açmamış dahil) okuyabilir.
    // Ayrı match bloğu zorunlu: genel {docId} kuralındaki isAdmin() çağrısı
    // admin_users/admin_invites get() okumalarını tetikler; bu okumalar
    // fail-closed davranışı gösterince || kısa devresi çalışmaz.
    match /admin_ntf_config/current_moment {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_ntf_config/{docId} {
      allow read, write: if isAdmin();
    }

    // Manuel zamanlanmış yayın bildirimleri — admin yazar/okur/iptal eder;
    // Cloud Function (admin SDK) status güncellemelerini kural dışı yapar.
    match /admin_scheduled_notifications/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.status == 'cancelled';
      allow delete: if isDeveloper();
    }

    // Ürün performansı yalnız Cloud Functions üzerinden yazılır ve okunur.
    // Ham anonim kurulum hash'leri istemci/admin uygulamasına açılmaz.
    match /admin_metric_daily_shards/{docId} {
      allow read, write: if false;
    }
    match /admin_content_metric_shards/{docId} {
      allow read, write: if false;
    }
    match /admin_widget_summary/{docId} {
      allow read, write: if false;
    }
    match /admin_widget_summary_shards/{docId} {
      allow read, write: if false;
    }
    match /admin_widget_installations/{docId} {
      allow read, write: if false;
    }
    match /admin_lock_notif_summary/{docId} {
      allow read, write: if false;
    }
    match /admin_lock_notif_summary_shards/{docId} {
      allow read, write: if false;
    }
    match /admin_lock_notif_installations/{docId} {
      allow read, write: if false;
    }
    match /admin_metric_audience/{docId} {
      allow read, write: if false;
    }
    match /admin_metric_audience_members/{docId} {
      allow read, write: if false;
    }
    match /admin_install_members/{docId} {
      allow read, write: if false;
    }
    match /admin_metric_event_dedupe/{docId} {
      allow read, write: if false;
    }
    match /admin_metric_rate_limits/{docId} {
      allow read, write: if false;
    }
    match /admin_ntf_deliveries/{deliveryId} {
      allow read, write: if false;
      match /clicks/{installHash} {
        allow read, write: if false;
      }
    }
    match /admin_ntf_delivery_click_shards/{docId} {
      allow read, write: if false;
    }

    // Dua Halkası yalnız App Check + güvenli oturum doğrulayan Cloud Functions
    // üzerinden okunur/yazılır. Kimlik, tepki, rapor ve cihaz tokenları
    // istemciye doğrudan açılmaz.
    match /prayer_requests/{requestId} {
      allow read, write: if false;

      match /reactions/{installationHash} {
        allow read, write: if false;
      }
      match /reports/{reporterHash} {
        allow read, write: if false;
      }
    }

    match /prayer_request_owners/{requestId} {
      allow read, write: if false;
    }

    match /prayer_devices/{installationHash} {
      allow read, write: if false;
    }

    match /prayer_rate_limits/{docId} {
      allow read, write: if false;
    }

    match /prayer_installations/{installationHash} {
      allow read, write: if false;
    }

    match /prayer_reward_proofs/{docId} {
      allow read, write: if false;
    }

    match /prayer_reward_transactions/{docId} {
      allow read, write: if false;
    }

    match /prayer_notification_jobs/{docId} {
      allow read, write: if false;
    }

    // Hilal Düellosu eşleştirme, cevap, profil ve reklam ödülleri yalnız
    // App Check kullanan Cloud Functions üzerinden işlenir. Doğru cevaplar ve
    // rakibin henüz açıklanmamış seçimi istemciye doğrudan açılmaz.
    match /quiz_installations/{docId} {
      allow read, write: if false;
    }
    match /quiz_players/{docId} {
      allow read, write: if false;
    }
    match /quiz_queue/{docId} {
      allow read, write: if false;
    }
    match /quiz_matches/{docId} {
      allow read, write: if false;
    }
    match /quiz_challenges/{docId} {
      allow read, write: if false;
    }
    match /quiz_reward_proofs/{docId} {
      allow read, write: if false;
    }
    match /quiz_reward_transactions/{docId} {
      allow read, write: if false;
    }
    match /quiz_rate_limits/{docId} {
      allow read, write: if false;
    }
    match /quiz_heart_charges/{docId} {
      allow read, write: if false;
    }
    match /quiz_weekly/{weekId} {
      allow read, write: if false;
      match /entries/{ownerHash} {
        allow read, write: if false;
      }
    }
    // Haftalık 1. Premium ödül ledger'ı — yalnız Cloud Functions.
    match /quiz_weekly_rewards/{weekId} {
      allow read, write: if false;
    }
    match /quiz_devices/{installationHash} {
      allow read, write: if false;
    }

    // Genel app_public belgeleri (quotes_bundle, widget_override vb.)
    match /app_public/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && docId in ['inspiration_cards', 'widget_override', 'widget_global_lock']
        && (docId != 'widget_global_lock'
          || !request.resource.data.keys().hasAny(['unlockHours'])
          || (request.resource.data.unlockHours is int
            && request.resource.data.unlockHours >= 1
            && request.resource.data.unlockHours <= 72));
    }

    // Premium yetki kayıtları:
    // - Kullanıcı yalnızca kendi UID kaydını veya kendi e-posta davetini okur.
    // - Yazma/listeleme sadece developer rolünde; satın alma doğrulaması ileride
    //   Cloud Function/RevenueCat webhook üzerinden aynı dokümanları günceller.
    match /premium_entitlements/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isDeveloper());
      allow list: if isDeveloper();
      allow write: if isDeveloper();
    }

    match /premium_invites/{email} {
      allow get: if signedIn() && (authEmail() == email || isDeveloper());
      allow list: if isDeveloper();
      allow write: if isDeveloper();
    }

    // Hesap silme kuyruğu: kullanıcı yalnızca kendi uid kaydını oluşturabilir.
    match /account_deletion_queue/{uid} {
      function deletionQueueEmailMatchesCaller() {
        return request.resource.data.email == null
          ? authEmail() == null
          : request.resource.data.email == authEmail();
      }

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && deletionQueueEmailMatchesCaller()
        && (resource == null || request.resource.data.email == resource.data.email)
        && request.resource.data.processedAt == null
        && request.resource.data.status == 'pending'
        && (resource == null || resource.data.status == 'pending')
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'requestedAt',
          'processedAt',
          'status',
        ]);
      allow read, delete: if false;
    }

    // Kullanıcı kök belgesi + bilinen alt koleksiyonlar.
    // Recursive serbest yazma yok: yeni user-scoped koleksiyon eklenirse burada
    // açıkça tanımlanmalı.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/habits/{habitId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/habit_logs/{logKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/zikir_matik/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId
        && docId == 'state';
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && docId == 'state'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'updatedAtMs',
          'syncedAt',
          'session',
          'customPhrases',
          'records',
          'turLogs',
          'settings',
        ]);
    }
    match /users/{userId}/user_backup/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId
        && docId == 'state';
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && docId == 'state'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'updatedAtMs',
          'syncedAt',
          'salatLogs',
          'location',
          'notifications',
          'appPrefs',
          'kaza',
        ]);
    }
    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }
  }
}
