[
  {
    "id": "v_1",
    "kind": "verse",
    "tr": "Allah bana yeter.",
    "ar": "حَسْبِيَ اللَّهُ",
    "verseReference": "Tevbe 129",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_2",
    "kind": "verse",
    "tr": "Ne elinizden gidene, ne de başınıza gelene üzülmeyin.",
    "ar": "لِكَيْلَا تَأْسَوْا عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا بِمَا آتَاكُمْ",
    "verseReference": "Hadîd 23",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_3",
    "kind": "verse",
    "tr": "Muhakkak ki âhiret senin için dünyadan daha hayırlıdır..",
    "ar": "وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ",
    "verseReference": "Duha 4",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_4",
    "kind": "verse",
    "tr": "Rabbinize yalvara yakara ve gizlice dua edin. Bilesiniz ki O, haddi aşanları sevmez.",
    "ar": "ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ",
    "verseReference": "A'râf 55",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_5",
    "kind": "verse",
    "tr": "İyiliğin karşılığı, yalnız iyiliktir.",
    "ar": "هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ",
    "verseReference": "Rahmân 60",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_6",
    "kind": "verse",
    "tr": "Vakti geldiğinde rabbin sana gönlündekini verecek ve seni hoşnut kılacak.",
    "ar": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ",
    "verseReference": "Duha 5",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_7",
    "kind": "verse",
    "tr": "Ne oluyor size de Allah'ın büyüklüğünü hesaba katmıyorsunuz.?",
    "ar": "مَا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًا",
    "verseReference": "Nûh 13",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_8",
    "kind": "verse",
    "tr": "Biz senin, yüzünü göğe doğru çevirdiğini elbette görüyoruz.",
    "ar": "قَدْ نَرَىٰ تَقَلُّبَ وَجْهِكَ فِي السَّمَاءِ",
    "verseReference": "Bakara 144",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_9",
    "kind": "verse",
    "tr": "Rabbinin rızâsına ermek için sabret.",
    "ar": "وَلِرَبِّكَ فَاصْبِرْ",
    "verseReference": "Müddessir 7",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_10",
    "kind": "verse",
    "tr": "Sana kesin olacak bir şeyi müjdeliyoruz, Sakın ümitsizliğe düşenlerden olma.",
    "ar": "قَالُوا بَشَّرْنَاكَ بِالْحَقِّ فَلَا تَكُنْ مِنَ الْقَانِطِينَ",
    "verseReference": "Hicr 55",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_11",
    "kind": "verse",
    "tr": "Şüphesiz, güçlükle beraber bir kolaylık vardır.",
    "ar": "إِنَّ مَعَ الْعُسْرِ يُسْرًا",
    "verseReference": "İnşirah 6",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_12",
    "kind": "verse",
    "tr": "Elbet işin sonu senin için öncesinden daha hayırlı olacaktır.",
    "ar": "وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ",
    "verseReference": "Duha 4",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_13",
    "kind": "verse",
    "tr": "Yoksa âhiretten vazgeçip dünya hayatına mı râzı oldunuz?",
    "ar": "أَرَضِيتُم بِالْحَيَاةِ الدُّنْيَا مِنَ الْآخِرَةِ",
    "verseReference": "Tevbe 38",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_14",
    "kind": "verse",
    "tr": "O kadar ayet okudum sadece birinde takılı kaldım; 'İnsanlar tesadüfen karşılaşmaz. Onları karşılaştıran Allah'tır.'",
    "ar": "وَأَلَّفَ بَيْنَ قُلُوبِهِمْ",
    "verseReference": "Enfâl 63",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_15",
    "kind": "verse",
    "tr": "Hakikaten onlar Rablerine inanan gençlerdi,",
    "ar": "إِنَّهُمْ فِتْيَةٌ آمَنُوا بِرَبِّهِمْ وَزِدْنَاهُمْ هُدًى",
    "verseReference": "Kehf 13",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_16",
    "kind": "verse",
    "tr": "Dünya hayatı bitince, kimin kazançlı çıkacağını öğreneceksiniz.",
    "ar": "فَسَوْفَ تَعْلَمُونَ مَن تَكُونُ لَهُ عَاقِبَةُ الدَّارِ",
    "verseReference": "En'âm 135",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_17",
    "kind": "verse",
    "tr": "Ve bil ki Allah her şeyi eninde sonunda hiç ummadığın şekilde düzeltir.",
    "ar": "وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ إِنَّ اللَّهَ بَالِغُ أَمْرِهِ",
    "verseReference": "Talâk 3",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_18",
    "kind": "verse",
    "tr": "Rabbinin hükmüne sabret.",
    "ar": "وَاصْبِرْ لِحُكْمِ رَبِّكَ",
    "verseReference": "Tûr 48",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_19",
    "kind": "verse",
    "tr": "Seni kurtaracağız.",
    "ar": "إِنَّا مُنَجُّوكَ وَأَهْلَكَ",
    "verseReference": "Ankebût 33",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_20",
    "kind": "verse",
    "tr": "Şüphesiz Allah sabredenlerle beraberdir.",
    "ar": "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
    "verseReference": "Bakara 153",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_21",
    "kind": "verse",
    "tr": "Öyleyse sabret, kuşkusuz Allah'ın verdiği söz kesindir.",
    "ar": "فَاصْبِرْ إِنَّ وَعْدَ اللَّهِ حَقٌّ",
    "verseReference": "Rûm 60",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_22",
    "kind": "verse",
    "tr": "Beni yaratan elbet yolumu gösterir.",
    "ar": "الَّذِي خَلَقَنِي فَهُوَ يَهْدِينِ",
    "verseReference": "Şuarâ 78",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_23",
    "kind": "verse",
    "tr": "Senin için gelecek geçmişten hayırlı olacak..",
    "ar": "وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ",
    "verseReference": "Duha 4",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_24",
    "kind": "verse",
    "tr": "Şüphesiz her zorlukla beraber bir kolaylık vardır.",
    "ar": "إِنَّ مَعَ الْعُسْرِ يُسْرًا",
    "verseReference": "İnşirah 5",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_25",
    "kind": "verse",
    "tr": "Rabbin seni bırakmadı ve sana darılmadı.",
    "ar": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
    "verseReference": "Duha 3",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_26",
    "kind": "verse",
    "tr": "Şüphesiz Allah sabredenlerle beraberdir.",
    "ar": "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
    "verseReference": "Bakara 153",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_27",
    "kind": "verse",
    "tr": "Allah bana yeter.",
    "ar": "حَسْبِيَ اللَّهُ",
    "verseReference": "Tevbe 129",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_28",
    "kind": "verse",
    "tr": "Ne elinizden gidene, ne de başınıza gelene üzülmeyin.",
    "ar": "لِكَيْلَا تَأْسَوْا عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا بِمَا آتَاكُمْ",
    "verseReference": "Hadîd 23",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_29",
    "kind": "verse",
    "tr": "Allah sabredenlerle beraberdir.",
    "ar": "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
    "verseReference": "Bakara 153",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_30",
    "kind": "verse",
    "tr": "Hüzünlenme, çünkü Allah bizimle beraberdir.",
    "ar": "لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا",
    "verseReference": "Tevbe 40",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_31",
    "kind": "verse",
    "tr": "Gevşemeyin, hüzünlenmeyin; eğer inanıyorsanız üstün olan sizsiniz.",
    "ar": "وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنتُمُ الْأَعْلَوْنَ إِن كُنتُم مُّؤْمِنِينَ",
    "verseReference": "Âl-i İmrân 139",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_32",
    "kind": "verse",
    "tr": "Allah, hiç kimseye gücünün üstünde bir yük yüklemez.",
    "ar": "لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا",
    "verseReference": "Bakara 286",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_33",
    "kind": "verse",
    "tr": "Rabbin, şüphesiz sana (nimet) verecek ve sen de hoşnut olacaksın.",
    "ar": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ",
    "verseReference": "Duha 5",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_34",
    "kind": "verse",
    "tr": "Şüphesiz benim Rabbim, duayı hakkıyla işitendir.",
    "ar": "إِنَّ رَبِّي لَسَمِيعُ الدُّعَاءِ",
    "verseReference": "İbrahim 39",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_35",
    "kind": "verse",
    "tr": "De ki: 'Her şey Allah’ın elindedir.'",
    "ar": "قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ",
    "verseReference": "Âl-i İmrân 73",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_36",
    "kind": "verse",
    "tr": "Nerede olursanız olun, O sizinle beraberdir.",
    "ar": "وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ",
    "verseReference": "Hadîd 4",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_37",
    "kind": "verse",
    "tr": "Allah bize yeter, O ne güzel vekildir.",
    "ar": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ",
    "verseReference": "Âl-i İmrân 173",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "v_38",
    "kind": "verse",
    "tr": "Doğrusu zorlukla beraber bir kolaylık vardır.",
    "ar": "إِنَّ مَعَ الْعُسْرِ يُسْرًا",
    "verseReference": "İnşirah 5",
    "source": "Ayet",
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  }
]
