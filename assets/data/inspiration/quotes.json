[
  {
    "id": "q_1",
    "kind": "quote",
    "tr": "\"Sabret, zira Allah'ın yazdığı senin hayal ettiklerinden daha güzeldir..\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 0,
    "reelsStyle": 7,
    "emphasisTailLines": 1
  },
  {
    "id": "q_2",
    "kind": "quote",
    "tr": "\"Alt üst olacaksın. Hatta ümitsizlikten öleceğim zannedeceksin Ama Rabb'in seni kurtaracak. SABRET\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 8,
    "reelsStyle": 13,
    "emphasisTailLines": 2
  },
  {
    "id": "q_3",
    "kind": "quote",
    "tr": "\"Allâh iyi niyetle çabalayan hiçbir kalbe yolunu şaşırtmaz..\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 6,
    "reelsStyle": 2,
    "emphasisTailLines": 0
  },
  {
    "id": "q_4",
    "kind": "quote",
    "tr": "\"İmtihan, vazgeçmediğin yerde başlar; nasip, sabrın bittiğini sandığında gelir.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 2,
    "reelsStyle": 4,
    "emphasisTailLines": 1
  },
  {
    "id": "q_5",
    "kind": "quote",
    "tr": "\"Sadece duâ et, sakin ol, fazla düşünme, Allâh'a inan, her şey yoluna girecek.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 5,
    "reelsStyle": 1,
    "emphasisTailLines": 1
  },
  {
    "id": "q_6",
    "kind": "quote",
    "tr": "\"Olmuyorsa olana kadar duâ ederiz olmuyor diye vazgeçecek değiliz çünkü biliriz ki; Kader Gayrete Aşıktır\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 8,
    "reelsStyle": 0,
    "emphasisTailLines": 2
  },
  {
    "id": "q_7",
    "kind": "quote",
    "tr": "\"Olabilecekleri düşünüp kalbini yorma. Allah'ın planı senin düşüncelerinden daha güzel. Buna inan ve hayatını öyle yaşa..\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 3,
    "reelsStyle": 6,
    "emphasisTailLines": 1
  },
  {
    "id": "q_8",
    "kind": "quote",
    "tr": "\"Vazgeçme, Allah isterse imkânsızı mümkün kılar.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 1,
    "reelsStyle": 8,
    "emphasisTailLines": 0
  },
  {
    "id": "q_9",
    "kind": "quote",
    "tr": "\"Ey tüm varlığın sahibi; göğün, yerin ve ağaçların Rabbi kalbim kırık sessizliğimi duadan say.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 10,
    "reelsStyle": 11,
    "emphasisTailLines": 2
  },
  {
    "id": "q_10",
    "kind": "quote",
    "tr": "\"Şükrettikçe, şükredeceğin şeyler artacak.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 0,
    "reelsStyle": 5,
    "emphasisTailLines": 0
  },
  {
    "id": "q_11",
    "kind": "quote",
    "tr": "\"Nasip.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 14,
    "reelsStyle": 9,
    "emphasisTailLines": 0
  },
  {
    "id": "q_12",
    "kind": "quote",
    "tr": "\"Unutma.. 'Kavuşmak aceleyle değil, Dua ile olur. Ve her dua nasibine bir adım daha yaklaştırır.'\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 4,
    "reelsStyle": 7,
    "emphasisTailLines": 1
  },
  {
    "id": "q_13",
    "kind": "quote",
    "tr": "\"'Allah'a bırakmak.'\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 12,
    "reelsStyle": 3,
    "emphasisTailLines": 0
  },
  {
    "id": "q_14",
    "kind": "quote",
    "tr": "\"'Elhamdülillah.'\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 7,
    "reelsStyle": 12,
    "emphasisTailLines": 0
  },
  {
    "id": "q_15",
    "kind": "quote",
    "tr": "\"Bazen olmaması, olmasından daha hâyırlıdır. 'Biz bilemeyiz, Allah bilir.'\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 6,
    "reelsStyle": 10,
    "emphasisTailLines": 1
  },
  {
    "id": "q_16",
    "kind": "quote",
    "tr": "\"'Allah'a yönel'\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 13,
    "reelsStyle": 6,
    "emphasisTailLines": 0
  },
  {
    "id": "q_17",
    "kind": "quote",
    "tr": "\"'Kul menfââtini düşünür, Allah kulunu düşünür.'\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 11,
    "reelsStyle": 1,
    "emphasisTailLines": 0
  },
  {
    "id": "q_18",
    "kind": "quote",
    "tr": "\"Hamd.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 15,
    "reelsStyle": 0,
    "emphasisTailLines": 0
  },
  {
    "id": "q_19",
    "kind": "quote",
    "tr": "\"'İnsan yara, Allah devâ.'\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 9,
    "reelsStyle": 11,
    "emphasisTailLines": 0
  },
  {
    "id": "q_20",
    "kind": "quote",
    "tr": "\"Allah'tan başka kim kalbi ferahlatabilir?\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 5,
    "reelsStyle": 4,
    "emphasisTailLines": 0
  },
  {
    "id": "q_21",
    "kind": "quote",
    "tr": "Hiçbir zafere çiçekli yollardan gidilmez. \"Cennet bile ölüm ister.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 16,
    "reelsStyle": 8,
    "emphasisTailLines": 1
  },
  {
    "id": "q_22",
    "kind": "quote",
    "tr": "Her zaman hallettik yine hallederiz. Allah eğilmez gönlümüzü kimseye muhtaç etmesin.",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 18,
    "reelsStyle": 5,
    "emphasisTailLines": 1
  },
  {
    "id": "q_23",
    "kind": "quote",
    "tr": "'Her şey kader...'",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 9,
    "reelsStyle": 2,
    "emphasisTailLines": 0
  },
  {
    "id": "q_24",
    "kind": "quote",
    "tr": "\"Birinci sırada Rabbin olmadığı sürece, birinci sıradakiler hep imtihanın olur..\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 2,
    "reelsStyle": 3,
    "emphasisTailLines": 1
  },
  {
    "id": "q_25",
    "kind": "quote",
    "tr": "\"Allahım, kalbimi senden gelen bir sevinçle doldur.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 7,
    "reelsStyle": 13,
    "emphasisTailLines": 0
  },
  {
    "id": "q_26",
    "kind": "quote",
    "tr": "Allâh bir şeyi nasip etmiyorsa koruyordur. Bir şeyi geciktiriyorsa, güzelleştiriyordur. \"Allâh'a güven.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 19,
    "reelsStyle": 6,
    "emphasisTailLines": 2
  },
  {
    "id": "q_27",
    "kind": "quote",
    "tr": "\"Hayaller, dualara emanet.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 1,
    "reelsStyle": 10,
    "emphasisTailLines": 0
  },
  {
    "id": "q_28",
    "kind": "quote",
    "tr": "\"Hz. Yusuf sabrederken zorlanmadı mı sanıyorsun. İmtihan sizi bulmaz Allah sizi seçer. Unutma Allah'ın seçtikleri daima değerlidir..\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 13,
    "reelsStyle": 11,
    "emphasisTailLines": 2
  },
  {
    "id": "q_29",
    "kind": "quote",
    "tr": "Allah imtihan ediyor ve diyor ki; \"Uğradığınız haksızlığın hesabını soramadığınızda üzülmeyin. Zira, bazı hesapları sorma kudreti yalnızca Allah'a aittir. Unutmayın ki, büyük işler büyük mahkemelerde görülür...\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 10,
    "reelsStyle": 12,
    "emphasisTailLines": 2
  },
  {
    "id": "q_30",
    "kind": "quote",
    "tr": "\"Allah bahtımızı güzel eylesin, Gerisi gelir, geçer.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 3,
    "reelsStyle": 0,
    "emphasisTailLines": 0
  },
  {
    "id": "q_31",
    "kind": "quote",
    "tr": "\"Kimseden bişey bekleme, güzellikler ancak Allahtan gelir.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 4,
    "reelsStyle": 2,
    "emphasisTailLines": 0
  },
  {
    "id": "q_32",
    "kind": "quote",
    "tr": "\"Bilesiniz ki, kalpler ancak Allah'ı anmakla huzur bulur.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 6,
    "reelsStyle": 9,
    "emphasisTailLines": 0
  },
  {
    "id": "q_33",
    "kind": "quote",
    "tr": "\"Kalbin Allah ile olduktan sonra, dünya sırtını dönse ne olur?\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 12,
    "reelsStyle": 7,
    "emphasisTailLines": 0
  },
  {
    "id": "q_34",
    "kind": "quote",
    "tr": "\"Ve bittiğini zannedersin sonra Allah her şeyi düzeltir.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 0,
    "reelsStyle": 3,
    "emphasisTailLines": 0
  },
  {
    "id": "q_35",
    "kind": "quote",
    "tr": "\"Gerçekten Allah'ın sana böyle bir kalp verdiğini ve seni aynı şekilde sevebilecek birini yaratmadığını mı düşünüyorsun?\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 8,
    "reelsStyle": 4,
    "emphasisTailLines": 1
  },
  {
    "id": "q_36",
    "kind": "quote",
    "tr": "\"gücünün yetmediği derdi, derdin sahibine bırak.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 11,
    "reelsStyle": 6,
    "emphasisTailLines": 0
  },
  {
    "id": "q_37",
    "kind": "quote",
    "tr": "\"Gökyüzü ne kadar karanlık olursa olsun, güneşi doğduracak olan Allah'tır.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 14,
    "reelsStyle": 1,
    "emphasisTailLines": 0
  },
  {
    "id": "q_38",
    "kind": "quote",
    "tr": "\"Bazen en güzel cevap, her şeyi sessizce Allah'a havale etmektir.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 15,
    "reelsStyle": 8,
    "emphasisTailLines": 0
  },
  {
    "id": "q_39",
    "kind": "quote",
    "tr": "\"Nasip, çok ince bir çizgidir; vaktini bekler, duayı bekler.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 17,
    "reelsStyle": 5,
    "emphasisTailLines": 0
  },
  {
    "id": "q_40",
    "kind": "quote",
    "tr": "\"Vakti gelmeyen hiçbir çiçek açmaz; nasibinde olan güzellikler, en doğru zamanda seni bulur.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 18,
    "reelsStyle": 10,
    "emphasisTailLines": 1
  },
  {
    "id": "q_41",
    "kind": "quote",
    "tr": "\"Nasip, gayrete aşıktır; sen yola çık.\"",
    "ar": null,
    "source": "Özlü söz",
    "verseReference": null,
    "layoutIndex": 19,
    "reelsStyle": 12,
    "emphasisTailLines": 0
  }
]