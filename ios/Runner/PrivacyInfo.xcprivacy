<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Meta App Events (facebook_app_events) reklam performansı ölçümü için
         ATT izniyle IDFA toplar ve Meta'ya iletir — bu Apple'ın tanımıyla
         "tracking" sayılır. App Store Connect → App Privacy'de
         "Data Used to Track You" bölümü bu beyanla eşleşmeli.

         DİKKAT: Facebook domain'leri (facebook.com vb.) buraya ASLA elle
         eklenmemeli. FBSDK'nın kendi PrivacyInfo.xcprivacy'si bu domain'leri
         zaten beyan ediyor; ayrıca FBSDK 18.x, uygulamanın manifest'inde
         "facebook.com" / "ep2.facebook.com" görürse development imzalı
         build'lerde KASITLI olarak InvalidOperationException fırlatıp
         uygulamayı çökertiyor (FBSDKDomainConfigurationManager
         processInvalidDomainsIfNeeded). Uygulamanın kendi kodu doğrudan
         tracking domain'ine bağlanmadığı için liste boş kalmalı. -->
    <key>NSPrivacyTracking</key>
    <true/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Apple'ın "Required Reason API" kuralı (Mayıs 2024+): aşağıdaki sistem
         API'leri reddedilmemek için mutlaka nedenle beyan edilmeli. Firebase,
         google_sign_in, audio_session, path_provider, shared_preferences,
         Hive gibi kütüphaneler bu API'leri dolaylı çağırıyor. Kendi kodumuz
         da `shared_preferences` (UserDefaults) ve `path_provider` (File Timestamp)
         üzerinden dokunuyor. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- shared_preferences → UserDefaults. Kullanım: kullanıcı tercihleri
             (tema, bildirim toggle'ları, onboarding flag'i, BGM son track). -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>1C8F.1</string>
            </array>
        </dict>
        <!-- path_provider / Hive / custom notification sound store → dosya
             tarih bilgisi. Cache TTL ve geçerlilik kontrolü için. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <!-- Bildirim planlaması (flutter_local_notifications) ve timezone
             bootstrap tarih/saat hesabı için sistem açılış zamanına bakıyor. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
        <!-- Ses/görsel cache klasörü yönetimi (audioplayers / healing tones). -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>

    <!-- App Store Connect "App Privacy" bölümü ile eşleşmesi gereken beyan.
         Linked = kullanıcı hesabına bağlı; Tracking = ATT gerektiren izleme. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Google / Apple Sign-In ile gelen e-posta. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Google / Apple Sign-In'den gelen görünen ad. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Firebase Auth tarafından yönetilen User ID (uid). -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Namaz vakitleri için kullanıcı konumu. LocationService `low`
             accuracy kullanıyor (~1 km), Apple bunu Coarse Location sayar. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Habit, salat log, arınma kayıtları, beğeni/kaydetmeler: user-generated
             content. Firestore'da users/{uid}/habits altında tutulur. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Firebase Analytics ürün etkileşimleri ile Meta App Events
             install/launch/onboarding dönüşümleri. Meta olayları reklam
             ölçümü ve optimizasyonunda kullanılabildiği için birleşik beyan
             tracking ve advertising amaçlarını da kapsar. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
            </array>
        </dict>
        <!-- Firebase Crashlytics: çökme olduğunda hata tanılama için raporlanır. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Crashlytics'in çökme dışı hata kayıtları ve cihaz/çalışma durumu
             tanılama parçaları. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Meta App Events (reklam ölçümü): ATT izni verilirse cihaz reklam
             kimliği (IDFA) Meta'ya iletilir; reklam performansı optimizasyonu
             (AEM) için kullanılır. Kullanıcıya bağlı değildir. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
            </array>
        </dict>
        <!-- Premium/destek satın alma tutarı ve para birimi, reklam
             optimizasyonu (dönüşüm ölçümü) için Meta'ya iletilir. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
