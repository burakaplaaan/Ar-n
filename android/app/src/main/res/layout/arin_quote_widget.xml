<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="28dp"
    android:paddingTop="7dp"
    android:paddingEnd="22dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_quote_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_quote_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textAllCaps="false"
                android:textColor="@color/widget_quote_text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <ImageView
                android:id="@+id/widget_quote_moon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_widget_crescent"
                android:tint="@color/widget_quote_text_white" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_quote_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:breakStrategy="balanced"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="start"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.02"
            android:lineSpacingExtra="0dp"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="0dp"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="18sp"
            android:textStyle="normal"
            tools:targetApi="m" />
    </LinearLayout>
</FrameLayout>
