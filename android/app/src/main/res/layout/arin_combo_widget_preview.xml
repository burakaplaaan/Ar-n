<?xml version="1.0" encoding="utf-8"?>
<!-- Karma widget önizleme: statik, sade, Chronometer yok.
     Kilit ekranı ve widget seçici listesinde düzgün görünür.
     Gerçek widget için initialLayout/initialKeyguardLayout kullanılır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_card_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arın · Karma"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <!-- Namaz vakti satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_widget_crescent"
            android:tint="@color/widget_quote_text_white"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:padding="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Akşam'a kalan"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Sayaç satırı (statik metin) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_widget_access_time"
            android:tint="@color/widget_quote_text_white"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:padding="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="1:24:10"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Söz metni -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="İşitirim ve görürüm."
        android:textColor="@color/widget_quote_text_white"
        android:textSize="14sp"
        android:fontFamily="serif"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.05"
        android:includeFontPadding="false" />

</LinearLayout>
