<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_tracking_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingStart="24dp"
    android:paddingTop="7dp"
    android:paddingEnd="22dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/widget_tracking_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_tracking_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#44000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Sigarasız gün sayacı" />

        <TextView
            android:id="@+id/widget_tracking_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Sigarasız 18. gün" />

        <TextView
            android:id="@+id/widget_tracking_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="2"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="14sp"
            tools:text="Kriz geçer, kararın kalır." />
    </LinearLayout>

    <!-- Kilit overlay: locked=true olduğunda VISIBLE, içeriğin ÜSTÜNDE görünür.
         Arka plan tamamen şeffaf (iOS widget'ı ile aynı davranış). -->
    <LinearLayout
        android:id="@+id/widget_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/widget_lock_overlay_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_lock"
            android:tint="@color/widget_quote_text_white" />

        <TextView
            android:id="@+id/widget_lock_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Açmak için dokunun"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="11sp" />

    </LinearLayout>
</FrameLayout>
