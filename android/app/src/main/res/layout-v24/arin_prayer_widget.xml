<?xml version="1.0" encoding="utf-8"?>
<!-- API 24+: Chronometer ile sistem içinde saniye saniye geri sayım (Alarm gerekmez). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="8dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:id="@+id/widget_prayer_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="1dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_crescent"
                android:tint="@color/widget_quote_text_white" />

            <TextView
                android:id="@+id/widget_prayer_next_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="@color/widget_quote_text_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:padding="1dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_access_time"
                android:tint="@color/widget_quote_text_white" />

            <Chronometer
                android:id="@+id/widget_prayer_countdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:countDown="true"
                android:format="%s"
                android:gravity="start|center_vertical"
                android:shadowColor="#90000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/widget_quote_text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_prayer_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="7sp" />
    </LinearLayout>

    <!-- Kilit overlay: locked=true olduğunda VISIBLE, içeriğin ÜSTÜNDE görünür.
         Arka plan tamamen şeffaf (iOS widget'ı ile aynı davranış). -->
    <LinearLayout
        android:id="@+id/widget_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/widget_lock_overlay_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_lock"
            android:tint="@color/widget_quote_text_white" />

        <TextView
            android:id="@+id/widget_lock_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Açmak için dokunun"
            android:textColor="@color/widget_quote_text_white"
            android:textSize="10sp" />

    </LinearLayout>
</FrameLayout>
